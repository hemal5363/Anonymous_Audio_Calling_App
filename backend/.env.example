# Server Host and Port
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anonymous_audio_calling

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production

# Initial Admin Credentials (used by npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPassword123!

# Admin Panel CORS Origin (comma-separated if multiple origins)
ADMIN_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Expo Dev CORS Origin (comma-separated if multiple origins, or * for all in development)
EXPO_DEV_ORIGIN=http://localhost:8081,http://127.0.0.1:8081

# WebRTC STUN / TURN Server Configuration (coturn)
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_SECRET=your_turn_shared_secret
TURN_USERNAME=turn_user
TURN_PASSWORD=turn_password

# Reverse Proxy Trust (1 for single reverse proxy e.g. Nginx, or IP / subnet)
TRUST_PROXY=1

# REST Rate Limits (Configurable Abuse Protection)
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_ACCOUNT_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_OTP_REQUEST_MAX=5
RATE_LIMIT_OTP_REQUEST_PHONE_MAX=3
RATE_LIMIT_OTP_REQUEST_WINDOW_MS=900000
RATE_LIMIT_OTP_VERIFY_MAX=10
RATE_LIMIT_OTP_VERIFY_PHONE_MAX=5
RATE_LIMIT_OTP_VERIFY_WINDOW_MS=900000

# Socket.io Abuse Protection
SOCKET_MAX_PAYLOAD_BYTES=65536
SOCKET_RATE_LIMIT_CALL_FIND_MAX=10
SOCKET_RATE_LIMIT_SIGNAL_MAX=60
SOCKET_RATE_LIMIT_ACCEPT_MAX=15
SOCKET_MAX_MALFORMED_EVENTS=5
SOCKET_SKIP_CANCEL_THRESHOLD=5
SOCKET_SKIP_CANCEL_WINDOW_MS=60000
SOCKET_SKIP_CANCEL_COOLDOWN_MS=30000

# Admin Security & Brute-Force Lockout
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15

